config APP_LOG_LEVEL
	int
	default 4

config BT_DEVICE_NAME
	string "device name"
	default "Zephyr Voice demo"

module = VOICE_DEMO
module-str = app
source "subsys/logging/Kconfig.template.log_config"

if REALTEK_PPT

choice VOICE_PPT_ROLE
	prompt "2.4G PPT role"
	default VOICE_PPT_MASTER

config VOICE_PPT_MASTER
	bool "Master (voice device, sends encoded audio)"
	select REALTEK_USING_PPT_SYNC_MASTER

config VOICE_PPT_SLAVE
	bool "Slave (dongle, receives and decodes audio)"
	select REALTEK_USING_PPT_SYNC_SLAVE

endchoice

endif # REALTEK_PPT

choice APP_UAC_SAMPLE_RATE
	prompt "UAC microphone sample rate"
	default APP_UAC_SAMPLE_RATE_16K

config APP_UAC_SAMPLE_RATE_16K
	bool "16 kHz"

config APP_UAC_SAMPLE_RATE_48K
	bool "48 kHz"

endchoice

config APP_UAC_SAMPLE_RATE
	int
	default 16000 if APP_UAC_SAMPLE_RATE_16K
	default 48000 if APP_UAC_SAMPLE_RATE_48K

source "Kconfig.zephyr"
